# Ignore everything in c2[5-9]* directories
c2[5-9]*

# Un-ignore directories so git can traverse them
!c2[5-9]*/
!c2[5-9]*/**/

# Ignore UiPath build artifacts and metadata
c2[5-9]*/.local/
c2[5-9]*/.settings/
c2[5-9]*/.tmh/
c2[5-9]*/.project/
c2[5-9]*/.objects/
c2[5-9]*/.entities/
c2[5-9]*/.templates/
c2[5-9]*/.pack-output/
c2[5-9]*/.dotnet/
c2[5-9]*/**/*.json
c2[5-9]*/*.uiproj

# Ignore rpax/rpacli tool output
c2[5-9]*/.rpax-warehouse/
c2[5-9]*/.rpacli-warehouse/

# Keep UiPath essentials - specific file types only
!c2[5-9]*/**/*.xaml
!c2[5-9]*/**/*.xaml.json
!c2[5-9]*/**/*.xlsx
!c2[5-9]*/**/*.cs
!c2[5-9]*/**/project.json
!c2[5-9]*/**/.gitkeep

# Ignore temporary/backup files (starting with ~) - must come after allows
c2[5-9]*/**/~*
