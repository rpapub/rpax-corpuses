# Ignore everything in c25* directories
c25*

# Un-ignore directories so git can traverse them
!c25*/
!c25*/**/

# Ignore UiPath build artifacts and metadata
c25*/.local/
c25*/.settings/
c25*/.tmh/
c25*/.project/
c25*/.objects/
c25*/.entities/
c25*/.templates/
c25*/.pack-output/
c25*/**/*.json
c25*/*.uiproj

# Ignore rpax/rpacli tool output
c25*/.rpax-warehouse/
c25*/.rpacli-warehouse/

# Keep UiPath essentials - specific file types only
!c25*/**/*.xaml
!c25*/**/*.xlsx
!c25*/**/*.cs
!c25*/**/project.json
!c25*/**/.gitkeep

# Ignore temporary/backup files (starting with ~) - must come after allows
c25*/**/~*
